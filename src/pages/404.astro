---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Icon from '@/components/common/Icon.astro';
import { ui } from '@/lib/i18n';

const en = ui.en;
const pt = ui.pt;

// Localized client-side: the static 404 is served for every unknown path in both locales
const destinations = [
  { id: 'dest-services', icon: 'layers' as const, key: 'nav.services' as const, en: '/services/', pt: '/pt/services/' },
  { id: 'dest-work', icon: 'briefcase' as const, key: 'nav.work' as const, en: '/projects/', pt: '/pt/projects/' },
  { id: 'dest-contact', icon: 'email' as const, key: 'nav.startProject' as const, en: '/contact/', pt: '/pt/contact/' },
];
---

<BaseLayout title={`${en['error404.title']} | JPCLOW`} description={en['error404.message']} noindex>
  <Header />

  <main id="main-content" tabindex="-1" class="force-dark surface grain relative isolate flex min-h-[88svh] items-center overflow-hidden" data-pointer-glow>
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="hero-aurora"></div>
      <div class="grid-floor opacity-80"></div>
      <div class="pointer-glow"></div>
    </div>

    <div class="studio-container py-32 text-center">
      <p class="display-xl text-outline fade-rise select-none" aria-hidden="true">404</p>
      <h1 id="error-heading" class="heading-section fade-rise mt-6" style="--d: 120ms">{en['error404.heading']}</h1>
      <p id="error-message" class="fade-rise mx-auto mt-5 max-w-xl text-base leading-relaxed text-[rgb(var(--color-text-secondary))] sm:text-lg" style="--d: 220ms">
        {en['error404.message']}
      </p>

      <div class="fade-rise mt-10 flex flex-wrap items-center justify-center gap-3" style="--d: 320ms">
        <a id="btn-home" href="/" class="btn btn-primary" data-magnetic="0.2">{en['error404.backHome']}</a>
        {destinations.map((destination) => (
          <a id={destination.id} href={destination.en} data-href-pt={destination.pt} data-label-key={destination.key} class="btn btn-ghost">
            <Icon name={destination.icon} size={16} />
            <span>{en[destination.key]}</span>
          </a>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script define:vars={{ en, pt }} is:inline>
  function applyLanguage() {
    const pathname = window.location.pathname;
    const storedLang = localStorage.getItem('languagePreference');
    const browserLang = (navigator.language || '').toLowerCase();

    const isPortuguese =
      pathname.startsWith('/pt') ||
      storedLang === 'pt' ||
      (!storedLang && browserLang.startsWith('pt'));

    if (!isPortuguese) return;

    document.documentElement.lang = 'pt';
    document.title = `${pt['error404.title']} | JPCLOW`;

    const setText = (id, value) => {
      const element = document.getElementById(id);
      if (element) element.textContent = value;
    };
    setText('error-heading', pt['error404.heading']);
    setText('error-message', pt['error404.message']);

    const homeBtn = document.getElementById('btn-home');
    if (homeBtn) {
      homeBtn.textContent = pt['error404.backHome'];
      homeBtn.setAttribute('href', '/pt/');
    }

    document.querySelectorAll('[data-href-pt]').forEach((link) => {
      link.setAttribute('href', link.dataset.hrefPt);
      const label = link.querySelector('span');
      if (label && link.dataset.labelKey) label.textContent = pt[link.dataset.labelKey];
    });
  }

  applyLanguage();
  document.addEventListener('astro:page-load', applyLanguage);
</script>
