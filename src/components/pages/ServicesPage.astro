---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Icon from '@/components/common/Icon.astro';
import ScrollReveal from '@/components/common/ScrollReveal.astro';
import Spotlight from '@/components/common/Spotlight.astro';
import PageHero from '@/components/studio/PageHero.astro';
import CapabilityMarquee from '@/components/studio/CapabilityMarquee.astro';
import ProcessSection from '@/components/studio/ProcessSection.astro';
import EngagementSection from '@/components/studio/EngagementSection.astro';
import FaqSection from '@/components/studio/FaqSection.astro';
import CtaBand from '@/components/studio/CtaBand.astro';
import { defaultLang, type Lang, ui } from '@/lib/i18n';
import { buildServicesSchema, buildStudioPageSchemas, getPageSeo, getSiteOgImageUrl } from '@/lib/seo';
import { getStudioCopy, projectHref } from '@/lib/studio';

const currentLang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = ui[currentLang] ?? ui[defaultLang];
const copy = getStudioCopy(currentLang);
const seo = getPageSeo('services', currentLang);
const siteUrl = Astro.site ?? new URL('https://jpclow.dev');
---

<BaseLayout title={seo.title} description={seo.description} keywords={seo.keywords} ogImage={getSiteOgImageUrl('services', currentLang)} schema={[buildServicesSchema(currentLang, siteUrl), ...buildStudioPageSchemas('services', currentLang, siteUrl)]}>
  <Header />
  <main id="main-content" tabindex="-1" class="relative overflow-x-clip">
    <PageHero eyebrow={copy.servicesPage.heroEyebrow} title={copy.servicesPage.heroTitle} lead={copy.servicesPage.heroLead} crumb={t['nav.services']}>
      <ul class="fade-rise mt-10 flex flex-wrap gap-2" style="--d: 480ms">
        {copy.services.map((service) => (
          <li>
            <a href={`#${service.id}`} class="chip px-3 py-2 text-xs transition-colors hover:border-[rgb(var(--color-accent))] hover:text-[rgb(var(--color-text-primary))]">
              <Icon name={service.icon} size={14} />
              {service.title}
            </a>
          </li>
        ))}
      </ul>
    </PageHero>

    <section aria-label={copy.servicesPage.heroEyebrow} class="studio-section">
      <div class="studio-container space-y-6">
        {copy.services.map((service, index) => (
          <ScrollReveal animation="fade-up">
            <Spotlight tag="article" class="panel scroll-mt-28 p-6 sm:p-10" data-service={service.id}>
              <div id={service.id} class="grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
                <div>
                  <div class="flex items-center gap-4">
                    <span class="icon-tile"><Icon name={service.icon} size={20} /></span>
                    <span class="mono-label">{`0${index + 1} / 0${copy.services.length}`}</span>
                  </div>
                  <h2 class="mt-6 text-3xl font-semibold tracking-tight sm:text-4xl">{service.title}</h2>
                  <p class="mt-3 text-lg text-[rgb(var(--color-text-primary))]">{service.summary}</p>
                  <p class="mt-4 text-base leading-relaxed text-[rgb(var(--color-text-secondary))]">{service.description}</p>
                </div>

                <div class="grid content-start gap-8 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
                  <div>
                    <p class="mono-label">{copy.labels.deliverables}</p>
                    <ul class="mt-3 space-y-2.5 text-sm">
                      {service.deliverables.map((item) => (
                        <li class="flex items-start gap-2.5">
                          <Icon name="check" size={16} class="mt-0.5 shrink-0 text-[rgb(var(--color-accent-hover))]" />
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div class="space-y-6">
                    <div>
                      <p class="mono-label">{copy.labels.stack}</p>
                      <ul class="mt-3 flex flex-wrap gap-1.5">
                        {service.stack.map((item) => <li class="chip">{item}</li>)}
                      </ul>
                    </div>
                    <div>
                      <p class="mono-label">{copy.labels.provenIn}</p>
                      <ul class="mt-1 flex flex-wrap gap-x-4">
                        {service.proof.map((project) => (
                          <li>
                            <a href={projectHref(project.slug, currentLang)} class="link-arrow text-sm">
                              {project.title}
                              <Icon name="arrow-up-right" size={14} />
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </Spotlight>
          </ScrollReveal>
        ))}
      </div>
    </section>

    <CapabilityMarquee />
    <ProcessSection index="01" />
    <EngagementSection index="02" />
    <FaqSection index="03" />
    <CtaBand />
  </main>
  <Footer />
</BaseLayout>
