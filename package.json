{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "astro preview",
    "astro": "astro",
    "test": "npm run test:unit && npm run test:e2e:chromium",
    "test:unit": "vitest --run",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "images:optimize": "node scripts/optimize-project-images.mjs",
    "scene:poster": "node scripts/capture-scene-poster.mjs",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts --project=chromium"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-satteri": "^0.3.4",
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^9.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/browser": "^11.0.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/three": "^0.185.1",
    "astro": "^7.2.0",
    "satori": "^0.33.4",
    "satori-html": "^0.3.2",
    "svelte": "^5.56.4",
    "tailwindcss": "^4.3.2",
    "three": "^0.185.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.61.1",
    "@vitest/ui": "^4.1.9",
    "happy-dom": "^20.11.0",
    "lighthouse": "^13.5.0",
    "sharp": "^0.34.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "yaml-language-server": {
      "yaml": "2.9.0"
    }
  }
}
