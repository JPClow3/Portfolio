---
import { getCollection, type CollectionEntry } from 'astro:content';
import Icon from '@/components/common/Icon.astro';
import ScrollReveal from '@/components/common/ScrollReveal.astro';
import SectionHeading from '@/components/studio/SectionHeading.astro';
import { defaultLang, type Lang, ui } from '@/lib/i18n';
import { getStudioCopy, localePath, projectHref } from '@/lib/studio';
import { projectImageSources } from '@/lib/images';
const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = ui[lang];
const copy = getStudioCopy(lang);
const section = copy.sections.work;
type Project = CollectionEntry<'projects'>;
const projects = (await getCollection('projects', ({ data }) => data.lang === lang && data.featured))
  .sort((a, b) => a.data.order - b.data.order).slice(0, 6);
const statuses: Partial<Record<Project['data']['status'], string>> = {
  'in-development': t['project.inDevelopment'], research: t['project.research'],
  prototype: t['project.prototype'], 'private-source': t['project.privateSource'], archived: t['project.archived'],
};
---
<section id="work" aria-labelledby="work-heading" class="studio-section">
  <div class="studio-container">
    <SectionHeading id="work-heading" index="01" eyebrow={section.eyebrow} title={section.title} lead={section.lead}>
      <a href={localePath('/projects/', lang)} class="link-arrow text-sm lg:col-start-2">{section.cta}<Icon name="arrow-up-right" size={16} /></a>
    </SectionHeading>
    <ol class="space-y-6">
      {projects.slice(0, 3).map((project, index) => (
        <li>
          <ScrollReveal animation="fade-up">
            <article data-testid="project-card" data-featured-story class="panel overflow-hidden">
              <div class="grid lg:grid-cols-[0.85fr_1.15fr]">
                <div class="flex flex-col p-6 sm:p-8">
                  <div class="flex flex-wrap items-center gap-3">
                    <span class="mono-label text-[rgb(var(--color-accent-hover))]">{String(index + 1).padStart(2, '0')}</span>
                    {project.data.year && <span class="mono-label">{project.data.year}</span>}
                    {statuses[project.data.status] && <span class="chip">{statuses[project.data.status]}</span>}
                  </div>
                  <h3 class="mt-5 text-3xl font-semibold tracking-tight sm:text-4xl">{project.data.title}</h3>
                  <p data-testid="project-outcome" class="mt-4 text-lg leading-relaxed">{project.data.showcase?.outcome ?? project.data.description}</p>
                  <dl class="mt-6 space-y-4 border-t border-[rgb(var(--color-border))] pt-5 text-sm leading-relaxed">
                    <div><dt class="mono-label">{t['home.problem']}</dt><dd class="mt-2 text-[rgb(var(--color-text-secondary))]">{project.data.showcase?.problem ?? project.data.decisionLog?.problem}</dd></div>
                    <div><dt class="mono-label">{copy.labels.contribution}</dt><dd class="mt-2 text-[rgb(var(--color-text-secondary))]">{project.data.showcase?.contribution ?? project.data.role}</dd></div>
                  </dl>
                  <div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-2 pt-6">
                    <a href={projectHref(project.data.slug, lang)} class="link-arrow text-sm" aria-label={`${copy.labels.viewCase} - ${project.data.title}`}>{copy.labels.viewCase}<Icon name="arrow-up-right" size={16} /></a>
                    {project.data.link && <a href={project.data.link} target="_blank" rel="noreferrer" class="link-arrow text-sm text-[rgb(var(--color-text-secondary))]" aria-label={`${t['home.live']} ${project.data.title}`}>{t['home.live']}</a>}
                  </div>
                </div>
                {project.data.image && (
                  <div class="flex flex-col justify-center border-t border-[rgb(var(--color-border))] bg-[rgb(var(--color-bg-tertiary)/0.45)] p-4 sm:p-6 lg:border-l lg:border-t-0">
                    <a href={projectHref(project.data.slug, lang)} aria-label={`${copy.labels.viewCase} - ${project.data.title}`}>
                      <img src={project.data.image} srcset={projectImageSources(project.data.image).srcset} sizes="(min-width: 1280px) 640px, (min-width: 1024px) 55vw, 100vw" alt={`${project.data.title} — ${t['projects.previewAlt']}`} class="aspect-[16/10] w-full rounded-md border border-[rgb(var(--color-border))] object-cover object-top" width="1440" height="900" loading="lazy" decoding="async" />
                    </a>
                    <ul class="mt-4 flex flex-wrap gap-2">{project.data.tech.slice(0, 4).map((tech) => <li class="chip">{tech}</li>)}</ul>
                  </div>
                )}
              </div>
            </article>
          </ScrollReveal>
        </li>
      ))}
    </ol>
    <h3 class="mono-label mb-5 mt-10">{copy.labels.moreWork}</h3>
    <ul class="grid gap-4 md:grid-cols-3">
      {projects.slice(3).map((project) => (
        <li>
          <ScrollReveal animation="fade-up" class="h-full">
            <article data-testid="project-card" data-compact-project class="panel flex h-full flex-col overflow-hidden">
              {project.data.image && <a href={projectHref(project.data.slug, lang)} aria-label={`${copy.labels.viewCase} - ${project.data.title}`}>
                <img src={project.data.image} srcset={projectImageSources(project.data.image).srcset} sizes="(min-width: 768px) 33vw, 100vw" alt={`${project.data.title} — ${t['projects.previewAlt']}`} width="1440" height="900" loading="lazy" decoding="async" class="aspect-[16/9] w-full border-b border-[rgb(var(--color-border))] object-cover object-top" />
              </a>}
              <div class="flex flex-1 flex-col p-5">
                {statuses[project.data.status] && <p class="mb-3"><span class="chip">{statuses[project.data.status]}</span></p>}
                <h4 class="text-xl font-semibold tracking-tight">{project.data.title}</h4>
                <p data-testid="project-outcome" class="mt-3 text-sm leading-relaxed text-[rgb(var(--color-text-secondary))]">{project.data.description}</p>
                <a href={projectHref(project.data.slug, lang)} class="link-arrow mt-auto pt-5 text-sm" aria-label={`${copy.labels.viewCase} - ${project.data.title}`}>{copy.labels.viewCase}<Icon name="arrow-up-right" size={16} /></a>
              </div>
            </article>
          </ScrollReveal>
        </li>
      ))}
    </ul>
  </div>
</section>
