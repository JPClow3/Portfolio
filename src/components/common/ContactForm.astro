---
import Icon from '@/components/common/Icon.astro';
import { defaultLang, type Lang, ui } from '@/lib/i18n';
import { getStudioCopy } from '@/lib/studio';

const currentLang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = ui[currentLang] ?? ui[defaultLang];
const copy = getStudioCopy(currentLang);

const web3FormsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? '';
const turnstileWorkerUrl = import.meta.env.PUBLIC_TURNSTILE_WORKER_URL ?? '';
const isContactFormEnabled = Boolean(web3FormsAccessKey);
const isTurnstileEnabled = Boolean(turnstileSiteKey && turnstileWorkerUrl);

const inputClass =
  'field w-full rounded-md border border-[rgb(var(--color-border))] bg-[rgb(var(--color-bg-primary)/0.7)] px-3.5 py-3 text-sm text-[rgb(var(--color-text-primary))] transition-colors placeholder:text-[rgb(var(--color-text-muted))] focus:outline-none';
const labelClass = 'block text-sm font-semibold text-[rgb(var(--color-text-primary))]';
---

{isContactFormEnabled ? (
  <form id="contact-form" class="panel space-y-5 p-5 text-left sm:p-7" novalidate>
    <input type="hidden" name="access_key" value={web3FormsAccessKey} />
    <input type="hidden" name="subject" value="New project inquiry — jpclow.dev" />
    <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

    <div class="flex items-center justify-between gap-4">
      <p class="mono-label">{copy.contactPage.formTitle}</p>
      <span class="status-dot" aria-hidden="true"></span>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div class="space-y-2">
        <label for="name" class={labelClass}>{t['contact.form.name']}</label>
        <input id="name" name="name" type="text" autocomplete="name" required aria-describedby="name-error" aria-invalid="false" placeholder={t['contact.form.placeholderName']} class={inputClass} />
        <p id="name-error" class="hidden text-sm text-[rgb(var(--color-error))]"></p>
      </div>

      <div class="space-y-2">
        <label for="email" class={labelClass}>{t['contact.form.email']}</label>
        <input id="email" name="email" type="email" autocomplete="email" required aria-describedby="email-error" aria-invalid="false" placeholder={t['contact.form.placeholderEmail']} class={inputClass} />
        <p id="email-error" class="hidden text-sm text-[rgb(var(--color-error))]"></p>
      </div>

      <div class="space-y-2">
        <label for="company" class={labelClass}>
          {t['contact.form.company']} <span class="font-normal text-[rgb(var(--color-text-muted))]">{t['contact.form.optional']}</span>
        </label>
        <input id="company" name="company" type="text" autocomplete="organization" placeholder={t['contact.form.placeholderCompany']} class={inputClass} />
      </div>

      <div class="space-y-2">
        <label for="service" class={labelClass}>
          {t['contact.form.service']} <span class="font-normal text-[rgb(var(--color-text-muted))]">{t['contact.form.optional']}</span>
        </label>
        <select id="service" name="service" class={inputClass}>
          <option value="">{t['contact.form.serviceUnsure']}</option>
          {copy.services.map((service) => <option value={service.title}>{service.title}</option>)}
        </select>
      </div>
    </div>

    <div class="space-y-2">
      <label for="message" class={labelClass}>{t['contact.form.message']}</label>
      <textarea id="message" name="message" rows="6" required minlength="10" aria-describedby="message-error" aria-invalid="false" placeholder={t['contact.form.placeholderMessage']} class:list={[inputClass, 'resize-y']}></textarea>
      <p id="message-error" class="hidden text-sm text-[rgb(var(--color-error))]"></p>
    </div>

    {isTurnstileEnabled && (
      <div class="space-y-2">
        <div class="cf-turnstile min-h-[65px]" data-sitekey={turnstileSiteKey} data-action="turnstile-spin-v1" data-theme="auto"></div>
        <p id="turnstile-error" class="hidden text-sm text-[rgb(var(--color-error))]"></p>
      </div>
    )}

    <button id="submit-btn" type="submit" class="btn btn-primary w-full disabled:cursor-not-allowed disabled:opacity-65 sm:w-auto">
      {t['contact.form.send']}
    </button>

    <div id="form-status" aria-live="polite" aria-atomic="true" class="min-h-6 text-sm">
      <p id="success-message" class="hidden items-center gap-2.5 font-medium text-[rgb(var(--color-success))] [&:not(.hidden)]:flex">
        <svg class="status-icon shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
        <span data-status-text>{t['contact.success']}</span>
      </p>
      <p id="error-message" class="hidden font-medium text-[rgb(var(--color-error))]">{t['contact.error']}</p>
    </div>
  </form>
) : (
  <div class="panel p-6 text-sm leading-relaxed text-[rgb(var(--color-text-secondary))] sm:p-8">
    <Icon name="email" size={20} class="mb-3 text-[rgb(var(--color-accent-hover))]" />
    <p>{t['contact.form.unavailable']}</p>
  </div>
)}

{isTurnstileEnabled && isContactFormEnabled && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

{isContactFormEnabled && (
  <script
    define:vars={{
      isTurnstileEnabled,
      turnstileWorkerUrl,
      messages: {
        sending: t['contact.form.sending'],
        send: t['contact.form.send'],
        success: t['contact.success'],
        error: t['contact.error'],
        network: t['contact.error.network'],
        validationFix: t['contact.validation.fix'],
        nameRequired: t['contact.validation.nameRequired'],
        emailRequired: t['contact.validation.emailRequired'],
        emailInvalid: t['contact.validation.emailInvalid'],
        messageRequired: t['contact.validation.messageRequired'],
        messageMin: t['contact.validation.messageMin'],
        turnstileRequired: t['contact.turnstile.required'],
        turnstileFailed: t['contact.turnstile.failed'],
      },
    }}
    is:inline
  >
    (() => {
      const form = document.getElementById('contact-form');
      if (!form) return;

      const submitButton = document.getElementById('submit-btn');
      const successMessage = document.getElementById('success-message');
      const errorMessage = document.getElementById('error-message');
      const turnstileError = document.getElementById('turnstile-error');

      const fields = {
        name: document.getElementById('name'),
        email: document.getElementById('email'),
        message: document.getElementById('message'),
      };

      const setError = (field, message) => {
        const error = document.getElementById(`${field.id}-error`);
        field.setAttribute('aria-invalid', message ? 'true' : 'false');
        if (!error) return;
        error.textContent = message || '';
        error.hidden = !message;
        error.classList.toggle('hidden', !message);
      };

      const setTurnstileError = (message) => {
        if (!turnstileError) return;
        turnstileError.textContent = message || '';
        turnstileError.hidden = !message;
        turnstileError.classList.toggle('hidden', !message);
      };

      const setStatus = (type, message) => {
        if (successMessage) {
          successMessage.hidden = type !== 'success';
          successMessage.classList.toggle('hidden', type !== 'success');
          const text = successMessage.querySelector('[data-status-text]');
          if (type === 'success' && text) text.textContent = message;
        }

        if (errorMessage) {
          errorMessage.hidden = type !== 'error';
          errorMessage.classList.toggle('hidden', type !== 'error');
          if (type === 'error') errorMessage.textContent = message;
        }
      };

      const resetTurnstile = () => {
        if (window.turnstile?.reset) {
          window.turnstile.reset();
        }
      };

      const validateField = (field) => {
        const value = field.value.trim();

        if (field === fields.name && !value) {
          setError(field, messages.nameRequired);
          return false;
        }

        if (field === fields.email) {
          if (!value) {
            setError(field, messages.emailRequired);
            return false;
          }

          if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
            setError(field, messages.emailInvalid);
            return false;
          }
        }

        if (field === fields.message) {
          if (!value) {
            setError(field, messages.messageRequired);
            return false;
          }

          if (value.length < 10) {
            setError(field, messages.messageMin);
            return false;
          }
        }

        setError(field, '');
        return true;
      };

      const validateForm = () => {
        const results = Object.values(fields).map((field) => validateField(field));
        return results.every(Boolean);
      };

      Object.values(fields).forEach((field) => {
        field.addEventListener('blur', () => validateField(field));
        field.addEventListener('input', () => {
          if (field.getAttribute('aria-invalid') === 'true') {
            validateField(field);
          }
        });
      });

      const verifyTurnstile = async () => {
        if (!isTurnstileEnabled) return true;

        const token = new FormData(form).get('cf-turnstile-response');
        if (!token) {
          setTurnstileError(messages.turnstileRequired);
          setStatus('error', messages.turnstileRequired);
          return false;
        }

        const response = await fetch(turnstileWorkerUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token }),
        });

        const data = await response.json().catch(() => null);
        if (!response.ok || !data?.success) {
          setTurnstileError(messages.turnstileFailed);
          setStatus('error', messages.turnstileFailed);
          resetTurnstile();
          return false;
        }

        setTurnstileError('');
        return true;
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        setStatus('', '');
        setTurnstileError('');

        if (!validateForm()) {
          setStatus('error', messages.validationFix);
          return;
        }

        submitButton.disabled = true;
        submitButton.dataset.loading = 'true';
        submitButton.setAttribute('aria-busy', 'true');
        submitButton.textContent = messages.sending;

        try {
          const isVerified = await verifyTurnstile();
          if (!isVerified) return;

          const response = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            body: new FormData(form),
          });

          const data = await response.json().catch(() => null);
          if (response.ok && data?.success) {
            form.reset();
            setStatus('success', messages.success);
            resetTurnstile();
            return;
          }

          setStatus('error', messages.error);
        } catch {
          setStatus('error', messages.network);
        } finally {
          submitButton.disabled = false;
          submitButton.dataset.loading = 'false';
          submitButton.removeAttribute('aria-busy');
          submitButton.textContent = messages.send;
        }
      });
    })();
  </script>
)}
