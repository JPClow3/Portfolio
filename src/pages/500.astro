---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/common/Icon.astro';
import { ui } from '@/lib/i18n';

interface Props {
  error?: unknown;
}

const { error } = Astro.props;
const en = ui.en;
const pt = ui.pt;
---

<BaseLayout title={en['error500.title']} description={en['error500.message']} noindex>
  <main id="main-content" tabindex="-1" class="noise-bg relative flex min-h-screen items-center justify-center overflow-hidden px-4 py-20 sm:px-6 lg:px-8">
    <div class="pointer-events-none fixed inset-0 -z-10">
      <div class="bg-grid absolute inset-0 opacity-45 dark:opacity-20"></div>
    </div>

    <div class="glass-panel relative z-10 flex w-full max-w-xl flex-col items-center justify-center rounded-2xl p-10 text-center sm:p-16 shadow-2xl">
      <!-- 500 Icon/Illustration -->
      <div class="mb-4">
        <h1 class="bg-gradient-to-r from-red-500 to-orange-400 bg-clip-text text-8xl font-extrabold text-transparent sm:text-9xl drop-shadow-sm">
          500
        </h1>
      </div>

      <!-- Error Message -->
      <h2 id="error-500-heading" class="mb-4 text-2xl font-bold text-[rgb(var(--color-text-primary))] sm:text-4xl">
        {en['error500.heading']}
      </h2>

      <p id="error-500-message" class="mb-8 text-base leading-relaxed text-[rgb(var(--color-text-secondary))] sm:text-lg">
        {en['error500.message']}
      </p>

      {import.meta.env.DEV && error && (
        <div class="mb-8 w-full rounded-md bg-[rgb(var(--color-bg-secondary))] p-4 text-left text-sm text-[rgb(var(--color-error))] overflow-auto max-h-32 shadow-inner border border-[rgb(var(--color-error)/0.2)]">
          <p class="font-mono">{error instanceof Error ? error.message : String(error)}</p>
        </div>
      )}

      <!-- Action Buttons -->
      <div class="flex flex-col items-center justify-center gap-4 w-full sm:w-auto sm:flex-row">
        <a
          id="btn-500-home"
          href="/"
          class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-md bg-[rgb(var(--color-accent))] px-6 py-3 font-semibold text-[rgb(var(--color-accent-contrast))] shadow-lg shadow-[rgb(var(--color-accent)/0.3)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[var(--shadow-accent-glow)]"
        >
          <Icon name="globe" size={20} />
          <span id="label-500-home">{en['error500.backHome']}</span>
        </a>
        
        <button
          id="btn-500-reload"
          type="button"
          onclick="window.location.reload()"
          class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-md border border-[rgb(var(--color-border))] bg-[rgb(var(--glass-tint)/0.2)] px-6 py-3 font-semibold text-[rgb(var(--color-text-primary))] transition-all duration-300 hover:-translate-y-1 hover:border-[rgb(var(--color-accent)/0.5)] hover:bg-[rgb(var(--color-bg-tertiary)/0.5)] hover:text-[rgb(var(--color-accent))]"
        >
          <Icon name="code" size={20} />
          <span id="label-500-reload">{en['error500.reload']}</span>
        </button>
      </div>
    </div>
  </main>
</BaseLayout>

<script define:vars={{ en, pt }} is:inline>
  function applyLanguage() {
    const pathname = window.location.pathname;
    const storedLang = localStorage.getItem('languagePreference');
    const browserLang = (navigator.language || '').toLowerCase();
    
    const isPortuguese =
      pathname.startsWith('/pt') ||
      storedLang === 'pt' ||
      (!storedLang && (browserLang.startsWith('pt') || browserLang === 'pt-br'));

    const dict = isPortuguese ? pt : en;
    const homeHref = isPortuguese ? '/pt/' : '/';

    document.title = `${dict['error500.title']} | João Paulo Santos`;

    const headingEl = document.getElementById('error-500-heading');
    if (headingEl) headingEl.textContent = dict['error500.heading'];

    const messageEl = document.getElementById('error-500-message');
    if (messageEl) messageEl.textContent = dict['error500.message'];

    const homeBtn = document.getElementById('btn-500-home');
    if (homeBtn) homeBtn.setAttribute('href', homeHref);

    const homeLabel = document.getElementById('label-500-home');
    if (homeLabel) homeLabel.textContent = dict['error500.backHome'];

    const reloadLabel = document.getElementById('label-500-reload');
    if (reloadLabel) reloadLabel.textContent = dict['error500.reload'];
  }

  applyLanguage();
  document.addEventListener('astro:page-load', applyLanguage);
</script>

<style>
  main {
    animation: fade-in-up 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    main {
      animation: none;
    }
  }
</style>
