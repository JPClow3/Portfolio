---
import ThemeToggle from '@components/islands/ThemeToggle.svelte';
import CommandPalette from '@components/islands/CommandPalette.svelte';
import Icon from '@components/common/Icon.astro';
import { getCollection } from 'astro:content';
import { defaultLang, type Lang, ui } from '@/lib/i18n';
import { buildCommandPaletteItems } from '@/lib/command-palette';

interface NavLink {
  label: string;
  href: string;
  section: string;
}

const currentLang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = ui[currentLang] ?? ui[defaultLang];

const isEnglish = currentLang === 'en';
const isPortuguese = currentLang === 'pt';
const localePrefix = isPortuguese ? '/pt' : '';

const profileEntries = await getCollection('profile', ({ data }) => data.lang === currentLang);
const fallbackProfileEntries = await getCollection('profile', ({ data }) => data.lang === defaultLang);
const profile = (profileEntries[0] ?? fallbackProfileEntries[0]).data.profile;

const localizedProjects = await getCollection('projects', ({ data }) => data.lang === currentLang && data.caseStudy);
const fallbackProjects = await getCollection('projects', ({ data }) => data.lang === defaultLang && data.caseStudy);
const paletteProjects = (localizedProjects.length > 0 ? localizedProjects : fallbackProjects)
  .sort((a, b) => a.data.order - b.data.order)
  .map((project) => ({ title: project.data.title, slug: project.data.slug, status: project.data.status }));
const paletteItems = buildCommandPaletteItems({ lang: currentLang, profile, projects: paletteProjects });
const paletteStrings = {
  title: t['palette.title'],
  trigger: t['palette.trigger'],
  placeholder: t['palette.placeholder'],
  empty: t['palette.empty'],
  hint: t['palette.hint'],
};

// Every page exists in both locales, so the switcher keeps the current path
const unprefixedPath = isPortuguese
  ? Astro.url.pathname.replace(/^\/pt(?=\/|$)/, '') || '/'
  : Astro.url.pathname;
const englishPath = unprefixedPath;
const portuguesePath = unprefixedPath === '/' ? '/pt/' : `/pt${unprefixedPath}`;

const navLinks: NavLink[] = [
  { label: t['nav.services'], href: `${localePrefix}/services/`, section: 'services' },
  { label: t['nav.work'], href: `${localePrefix}/projects/`, section: 'work' },
  { label: t['nav.process'], href: `${localePrefix}/#process`, section: 'process' },
  { label: t['nav.company'], href: `${localePrefix}/about/`, section: 'about' },
  { label: t['nav.blog'], href: `${localePrefix}/blog/`, section: 'blog' },
];
const contactHref = `${localePrefix}/contact/`;
---

<header
  id="header"
  class="force-dark fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color,box-shadow] duration-300"
>
  <nav aria-label="Primary" class="studio-container">
    <div class="flex h-16 items-center justify-between gap-4 lg:h-[4.5rem]">
      <a
        href={`${localePrefix}/`}
        id="site-logo"
        data-logo-signal
        class="inline-flex shrink-0 items-center transition-opacity hover:opacity-85"
        aria-label="JPCLOW home"
      >
        <img
          src="/brand/jpclow-logo-negative.svg"
          alt="JPCLOW"
          width="47"
          height="32"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="h-8 w-auto"
        />
      </a>

      <!-- Desktop Navigation -->
      <div data-nav-track class="relative hidden items-center gap-0.5 rounded-[var(--radius-lg)] border border-[rgb(var(--color-border))] bg-[rgb(var(--color-bg-secondary)/0.55)] p-1 backdrop-blur-xl lg:flex">
        <span class="nav-indicator" data-nav-indicator aria-hidden="true"></span>
        {navLinks.map((link) => (
          <a
            href={link.href}
            data-nav-link
            data-nav-section={link.section}
            class="nav-link nav-link--track relative z-10 rounded-md px-3.5 py-2 text-sm font-medium text-[rgb(var(--color-text-secondary))] transition-colors hover:text-[rgb(var(--color-text-primary))]"
          >
            {link.label}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-2">
        <div class="hidden items-center gap-0.5 rounded-md border border-[rgb(var(--color-border))] bg-[rgb(var(--color-bg-secondary)/0.55)] p-0.5 lg:flex" role="group" aria-label="Select language">
          <a
            href={englishPath}
            data-lang-link
            data-lang-base="/"
            class:list={[
              'rounded px-2.5 py-1 text-xs font-semibold transition-colors',
              isEnglish ? 'bg-[rgb(var(--color-bg-tertiary))] text-[rgb(var(--color-text-primary))]' : 'text-[rgb(var(--color-text-muted))] hover:text-[rgb(var(--color-text-primary))]',
            ]}
            aria-label="EN — Switch to English"
            aria-current={isEnglish ? 'true' : undefined}
          >EN</a>
          <a
            href={portuguesePath}
            data-lang-link
            data-lang-base="/pt/"
            class:list={[
              'rounded px-2.5 py-1 text-xs font-semibold transition-colors',
              isPortuguese ? 'bg-[rgb(var(--color-bg-tertiary))] text-[rgb(var(--color-text-primary))]' : 'text-[rgb(var(--color-text-muted))] hover:text-[rgb(var(--color-text-primary))]',
            ]}
            aria-label="PT — Mudar para Português"
            aria-current={isPortuguese ? 'true' : undefined}
          >PT</a>
        </div>

        <div class="hidden xl:block">
          <CommandPalette items={paletteItems} strings={paletteStrings} client:load />
        </div>
        <ThemeToggle client:load />

        <a href={contactHref} data-nav-link data-nav-section="contact" data-magnetic="0.2" class="btn btn-primary hidden min-h-10 px-4 text-sm sm:inline-flex">
          {t['nav.startProject']}
          <Icon name="arrow-right" size={16} class="btn-arrow" />
        </a>

        <button
          type="button"
          class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-md p-2 text-[rgb(var(--color-text-primary))] transition-colors hover:bg-[rgb(var(--color-bg-secondary))] lg:hidden"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          id="mobile-menu-button"
        >
          <span id="menu-icon-open" aria-hidden="true" class="flex items-center justify-center">
            <Icon name="menu" size={24} />
          </span>
          <span id="menu-icon-close" aria-hidden="true" class="hidden flex items-center justify-center">
            <Icon name="close" size={24} />
          </span>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <div
      id="mobile-menu"
      role="navigation"
      aria-label="Mobile navigation"
      class="overflow-hidden rounded-[var(--radius-lg)] border border-[rgb(var(--color-border))] bg-[rgb(var(--color-bg-secondary))] shadow-[0_24px_60px_rgb(0_0_0/0.45)] transition-all duration-300 ease-in-out lg:hidden"
      style="max-height: 0; opacity: 0;"
    >
      <div class="flex flex-col gap-1 p-2">
        {navLinks.map((link) => (
          <a
            href={link.href}
            data-nav-link
            data-nav-section={link.section}
            class="nav-link flex min-h-11 items-center justify-between rounded-md px-4 py-2.5 text-base font-medium text-[rgb(var(--color-text-secondary))] transition-colors hover:bg-[rgb(var(--color-bg-tertiary))] hover:text-[rgb(var(--color-text-primary))]"
          >
            {link.label}
            <Icon name="arrow-up-right" size={16} class="text-[rgb(var(--color-text-muted))]" />
          </a>
        ))}
        <a href={contactHref} class="btn btn-primary mt-2 w-full">
          {t['nav.startProject']}
          <Icon name="arrow-right" size={16} class="btn-arrow" />
        </a>

        <div class="mt-2 flex items-center gap-2 border-t border-[rgb(var(--color-border))] px-2 pt-3" role="group" aria-label="Select language">
          <Icon name="globe" size={16} class="text-[rgb(var(--color-text-muted))]" />
          <a
            href={englishPath}
            data-lang-link
            data-lang-base="/"
            class:list={[
              'inline-flex min-h-11 min-w-11 items-center justify-center rounded px-3 py-1.5 text-xs font-semibold transition-colors',
              isEnglish ? 'bg-[rgb(var(--color-accent))] text-white' : 'bg-[rgb(var(--color-bg-tertiary))] text-[rgb(var(--color-text-secondary))] hover:text-[rgb(var(--color-text-primary))]',
            ]}
            aria-label="EN — Switch to English"
            aria-current={isEnglish ? 'true' : undefined}
          >EN</a>
          <a
            href={portuguesePath}
            data-lang-link
            data-lang-base="/pt/"
            class:list={[
              'inline-flex min-h-11 min-w-11 items-center justify-center rounded px-3 py-1.5 text-xs font-semibold transition-colors',
              isPortuguese ? 'bg-[rgb(var(--color-accent))] text-white' : 'bg-[rgb(var(--color-bg-tertiary))] text-[rgb(var(--color-text-secondary))] hover:text-[rgb(var(--color-text-primary))]',
            ]}
            aria-label="PT — Mudar para Português"
            aria-current={isPortuguese ? 'true' : undefined}
          >PT</a>
        </div>
      </div>
    </div>
  </nav>
  <span class="header-progress" aria-hidden="true"></span>
</header>

<script>
  // Global listener references for cleanup
  let globalEscapeHandler: ((e: KeyboardEvent) => void) | null = null;
  let globalClickHandler: ((e: MouseEvent) => void) | null = null;
  let globalResizeHandler: (() => void) | null = null;
  let activeNavObserver: IntersectionObserver | null = null;
  let activeNavScrollHandler: (() => void) | null = null;

  function initMobileMenu() {
    const menuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (!menuButton || !mobileMenu) return;

    const menuButtonEl = menuButton;
    const mobileMenuEl = mobileMenu;

    // Guard against re-initialization
    if (menuButtonEl.dataset.initialized === 'true') return;
    menuButtonEl.dataset.initialized = 'true';

    let isOpen = false;
    let focusTrapActive = false;
    let focusTrapHandler: ((e: KeyboardEvent) => void) | null = null;

    function toggleMenu(open?: boolean) {
      isOpen = open !== undefined ? open : !isOpen;

      // Update aria-expanded
      menuButtonEl.setAttribute('aria-expanded', String(isOpen));

      // Toggle icons
      if (iconOpen && iconClose) {
        iconOpen.classList.toggle('hidden', isOpen);
        iconClose.classList.toggle('hidden', !isOpen);
      }

      // Animate menu
      if (isOpen) {
        mobileMenuEl.style.maxHeight = `${mobileMenuEl.scrollHeight}px`;
        mobileMenuEl.style.opacity = '1';
        focusTrapActive = true;
        attachFocusTrap();

        const firstMenuItem = mobileMenuEl.querySelector('a, button, [tabindex]:not([tabindex="-1"])');
        if (firstMenuItem instanceof HTMLElement) {
          window.requestAnimationFrame(() => firstMenuItem.focus());
        }
      } else {
        mobileMenuEl.style.maxHeight = '0';
        mobileMenuEl.style.opacity = '0';
        focusTrapActive = false;
        detachFocusTrap();
        menuButtonEl.focus();
      }
    }

    function closeMenu() {
      toggleMenu(false);
    }

    function attachFocusTrap() {
      const focusableElements = Array.from(
        mobileMenuEl.querySelectorAll('a, button, [tabindex]:not([tabindex="-1"])')
      ) as HTMLElement[];
      
      if (focusableElements.length === 0) return;

      const firstElement = focusableElements[0];
      const lastElement = focusableElements[focusableElements.length - 1];

      // Remove old handler if it exists
      if (focusTrapHandler) {
        mobileMenuEl.removeEventListener('keydown', focusTrapHandler);
      }

      // Create new handler
      focusTrapHandler = (e: KeyboardEvent) => {
        if (!focusTrapActive || e.key !== 'Tab') return;

        if (e.shiftKey && document.activeElement === firstElement) {
          e.preventDefault();
          lastElement.focus();
        } else if (!e.shiftKey && document.activeElement === lastElement) {
          e.preventDefault();
          firstElement.focus();
        }
      };

      mobileMenuEl.addEventListener('keydown', focusTrapHandler);
    }

    function detachFocusTrap() {
      if (focusTrapHandler) {
        mobileMenuEl.removeEventListener('keydown', focusTrapHandler);
        focusTrapHandler = null;
      }
    }

    // Toggle on button click
    menuButtonEl.addEventListener('click', () => toggleMenu());

    // Close menu when clicking a link
    const links = mobileMenuEl.querySelectorAll('a');
    links.forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    // Set up global listeners only once
    attachGlobalListeners(closeMenu);
  }

  function attachGlobalListeners(closeMenu: () => void) {
    const menuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    if (!menuButton || !mobileMenu) return;

    // Remove old handlers if they exist (from previous initialization)
    if (globalEscapeHandler) {
      document.removeEventListener('keydown', globalEscapeHandler);
    }
    if (globalClickHandler) {
      document.removeEventListener('click', globalClickHandler);
    }
    if (globalResizeHandler) {
      window.removeEventListener('resize', globalResizeHandler);
    }

    // Create and attach new handlers
    globalEscapeHandler = (e: KeyboardEvent) => {
      const currentIsOpen = menuButton.getAttribute('aria-expanded') === 'true';
      if (e.key === 'Escape' && currentIsOpen) {
        closeMenu();
      }
    };

    globalClickHandler = (e: MouseEvent) => {
      const currentIsOpen = menuButton.getAttribute('aria-expanded') === 'true';
      const target = e.target as Node;
      if (currentIsOpen && !menuButton.contains(target) && !mobileMenu.contains(target)) {
        closeMenu();
      }
    };

    globalResizeHandler = () => {
      const currentIsOpen = menuButton.getAttribute('aria-expanded') === 'true';
      if (window.innerWidth >= 768 && currentIsOpen) {
        closeMenu();
      }
    };

    document.addEventListener('keydown', globalEscapeHandler);
    document.addEventListener('click', globalClickHandler);
    window.addEventListener('resize', globalResizeHandler);
  }

  // Header scroll effect with guard
  function initHeaderScroll() {
    const header = document.getElementById('header');
    if (!header || header.dataset.scrollInitialized === 'true') return;
    const headerEl = header;
    headerEl.dataset.scrollInitialized = 'true';

    let lastY = window.scrollY;

    function handleScroll() {
      const y = window.scrollY;
      headerEl.classList.toggle('scrolled', y > 50);

      // Hide while reading downward, reveal on any upward intent; never while the mobile menu is open
      const menuOpen = document.getElementById('mobile-menu-button')?.getAttribute('aria-expanded') === 'true';
      const focusInside = headerEl.contains(document.activeElement);
      if (Math.abs(y - lastY) > 6) {
        headerEl.dataset.hidden = String(y > lastY && y > 320 && !menuOpen && !focusInside);
        lastY = y;
      }
    }

    headerEl.addEventListener('focusin', () => {
      headerEl.dataset.hidden = 'false';
    });

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll(); // Check initial state
  }

  function initLangLinks() {
    const hash = window.location.hash;
    const pathname = window.location.pathname;
    
    const isPt = pathname.startsWith('/pt/') || pathname === '/pt';
    let canonicalPath = isPt ? pathname.replace(/^\/pt/, '') : pathname;
    if (!canonicalPath.startsWith('/')) {
      canonicalPath = '/' + canonicalPath;
    }
    const cleanCanonical = canonicalPath === '/' ? '' : canonicalPath.slice(1);
    
    document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]').forEach((link) => {
      const base = link.dataset.langBase;
      if (base) {
        link.href = base + cleanCanonical + hash;
        link.addEventListener('click', () => {
          localStorage.setItem('languagePreference', base === '/pt/' ? 'pt' : 'en');
        });
      }
    });
  }

  function dispatchSceneSection(section: string) {
    // The case-study ambient scene still keys its mood on the legacy 'projects' name
    window.dispatchEvent(new CustomEvent('portfolio:section-change', {
      detail: { section: section === 'work' ? 'projects' : section },
    }));
  }

  let indicatorHover: HTMLElement | null = null;

  function moveNavIndicator() {
    const track = document.querySelector<HTMLElement>('[data-nav-track]');
    const indicator = track?.querySelector<HTMLElement>('[data-nav-indicator]');
    if (!track || !indicator) return;

    const active = track.querySelector<HTMLElement>('.nav-link--track[data-active="true"]');
    const target = indicatorHover ?? active;
    if (!target) {
      indicator.dataset.visible = 'false';
      return;
    }

    indicator.style.setProperty('--ix', `${target.offsetLeft}px`);
    indicator.style.setProperty('--iw', `${target.offsetWidth}px`);
    indicator.style.setProperty('--active-bar', target === active ? '1' : '0');
    indicator.dataset.visible = 'true';
  }

  function initNavIndicator() {
    const track = document.querySelector<HTMLElement>('[data-nav-track]');
    if (!track || track.dataset.indicatorInitialized === 'true') return;
    track.dataset.indicatorInitialized = 'true';

    track.querySelectorAll<HTMLElement>('.nav-link--track').forEach((link) => {
      const enter = () => {
        indicatorHover = link;
        moveNavIndicator();
      };
      link.addEventListener('pointerenter', enter);
      link.addEventListener('focus', enter);
    });
    const leave = () => {
      indicatorHover = null;
      moveNavIndicator();
    };
    track.addEventListener('pointerleave', leave);
    track.addEventListener('focusout', leave);
    window.addEventListener('resize', moveNavIndicator, { passive: true });
    // Link widths change when the web font replaces the fallback; re-measure once it has loaded
    document.fonts?.ready.then(moveNavIndicator);
  }

  function setActiveNav(section: string) {
    document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((link) => {
      const isActive = link.dataset.navSection === section;
      link.dataset.active = String(isActive);

      if (isActive) {
        link.setAttribute('aria-current', 'location');
      } else {
        link.removeAttribute('aria-current');
      }
    });

    moveNavIndicator();
    dispatchSceneSection(section);
  }

  function getRouteSection() {
    const path = window.location.pathname;

    const unprefixed = path.replace(/^\/pt(?=\/|$)/, '') || '/';
    const routeSections: Array<[string, string]> = [
      ['/blog', 'blog'],
      ['/projects', 'work'],
      ['/services', 'services'],
      ['/about', 'about'],
      ['/contact', 'contact'],
    ];

    return routeSections.find(([prefix]) => unprefixed.startsWith(prefix))?.[1] ?? '';
  }

  function getHomepageSections() {
    // Sections without a nav link clear the highlight while they are in view
    return ['top', 'services', 'work', 'process', 'engineering', 'sectors', 'engagement', 'faq', 'contact']
      .map((id) => document.getElementById(id))
      .filter((section): section is HTMLElement => Boolean(section));
  }

  function findCurrentHomepageSection(sections: HTMLElement[]) {
    const anchorY = window.innerHeight * 0.38;
    let bestSection = sections[0]?.id ?? '';
    let bestDistance = Number.POSITIVE_INFINITY;

    sections.forEach((section) => {
      const rect = section.getBoundingClientRect();
      const crossesAnchor = rect.top <= anchorY && rect.bottom >= anchorY;
      const distance = crossesAnchor ? 0 : Math.min(Math.abs(rect.top - anchorY), Math.abs(rect.bottom - anchorY));

      if (distance < bestDistance) {
        bestDistance = distance;
        bestSection = section.id;
      }
    });

    return bestSection;
  }

  function initActiveNav() {
    if (activeNavObserver) {
      activeNavObserver.disconnect();
      activeNavObserver = null;
    }

    if (activeNavScrollHandler) {
      window.removeEventListener('scroll', activeNavScrollHandler);
      window.removeEventListener('resize', activeNavScrollHandler);
      activeNavScrollHandler = null;
    }

    const routeSection = getRouteSection();

    if (routeSection) {
      setActiveNav(routeSection);
      return;
    }

    const sections = getHomepageSections();
    if (sections.length === 0) {
      setActiveNav('');
      return;
    }

    let currentSection = '';
    const syncActiveSection = () => {
      const nextSection = findCurrentHomepageSection(sections);

      if (nextSection !== currentSection) {
        currentSection = nextSection;
        setActiveNav(nextSection);
      }
    };

    activeNavScrollHandler = syncActiveSection;

    if (typeof IntersectionObserver !== 'undefined') {
      activeNavObserver = new IntersectionObserver(syncActiveSection, {
        rootMargin: '-28% 0px -58% 0px',
        threshold: [0, 0.1, 0.35, 0.7],
      });

      sections.forEach((section) => activeNavObserver?.observe(section));
    } else {
      window.addEventListener('scroll', syncActiveSection, { passive: true });
    }

    window.addEventListener('resize', syncActiveSection);
    syncActiveSection();
  }

  function initLogoSignal() {
    const logo = document.querySelector<HTMLElement>('[data-logo-signal]');
    if (!logo || logo.dataset.logoInitialized === 'true') return;

    logo.dataset.logoInitialized = 'true';
    const emit = (active: boolean) => {
      window.dispatchEvent(new CustomEvent('portfolio:logo-focus', {
        detail: { active },
      }));
    };

    logo.addEventListener('pointerenter', () => emit(true), { passive: true });
    logo.addEventListener('pointerleave', () => emit(false), { passive: true });
    logo.addEventListener('focus', () => emit(true));
    logo.addEventListener('blur', () => emit(false));
  }

  // Initialize on load
  initMobileMenu();
  initHeaderScroll();
  initLangLinks();
  initActiveNav();
  initLogoSignal();
  initNavIndicator();
  window.addEventListener('hashchange', initLangLinks);

  // Re-initialize on Astro page transitions
  document.addEventListener('astro:page-load', () => {
    // Only re-initialize header scroll (listeners are already attached globally)
    initHeaderScroll();
    initLangLinks();
    initActiveNav();
    initLogoSignal();
    initNavIndicator();
  });
</script>

<style>
  #header.scrolled {
    background: rgb(var(--color-bg-primary) / 0.9);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    border-bottom-color: rgb(var(--color-border) / 0.8);
    box-shadow: 0 10px 40px rgb(0 0 0 / 0.35);
  }

  .nav-link[data-active="true"] {
    color: rgb(var(--color-text-primary));
    background: rgb(var(--color-bg-tertiary));
  }

  .nav-link--track[data-active="true"] {
    background: transparent;
  }

  @media (prefers-reduced-motion: reduce) {
    #header {
      transition: none;
    }
  }
</style>
