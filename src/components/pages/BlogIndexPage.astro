---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import EmptyState from '@/components/common/EmptyState.astro';
import Icon from '@/components/common/Icon.astro';
import { defaultLang, type Lang, ui } from '@/lib/i18n';
import { buildBreadcrumbSchema, getBlogIndexSeo, getSiteOgImageUrl } from '@/lib/seo';
import Spotlight from '@/components/common/Spotlight.astro';
import PageHero from '@/components/studio/PageHero.astro';
import CtaBand from '@/components/studio/CtaBand.astro';
import { calculateReadingTime } from '@/lib/blog';

interface Props {
  lang?: Lang;
}

const { lang } = Astro.props;
const currentLang = (lang ?? Astro.currentLocale ?? defaultLang) as Lang;
const t = ui[currentLang] ?? ui[defaultLang];
const blogSeo = getBlogIndexSeo(currentLang);
const isPt = currentLang === 'pt';

const langPosts = await getCollection('blog', ({ data }) => !data.draft && data.lang === currentLang && data.slug !== 'hello-world');
const fallbackPosts = await getCollection('blog', ({ data }) => !data.draft && data.lang !== currentLang && data.slug !== 'hello-world');

const postsToShow = langPosts.length > 0 ? langPosts : fallbackPosts;
const sortedPosts = postsToShow.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const siteUrl = Astro.site ?? new URL('https://jpclow.dev');
const blogPath = isPt ? '/pt/blog/' : '/blog/';
const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: isPt ? 'Notas de engenharia da JPCLOW' : 'JPCLOW engineering notes',
  description: blogSeo.description,
  url: new URL(blogPath, siteUrl).toString(),
  inLanguage: isPt ? 'pt-BR' : 'en-US',
  publisher: { '@id': `${siteUrl}#organization` },
  blogPost: sortedPosts.map((post) => {
    const slug = post.data.slug ?? post.id.replace(/^pt\//, '');
    const postUrl = isPt ? `/pt/blog/${slug}/` : `/blog/${slug}/`;
    return {
      '@type': 'BlogPosting',
      headline: post.data.title,
      datePublished: post.data.pubDate.toISOString(),
      dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
      url: new URL(postUrl, siteUrl).toString(),
    };
  }),
};

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: t['project.breadcrumbHome'], url: new URL(isPt ? '/pt/' : '/', siteUrl).toString() },
  { name: 'Blog', url: new URL(blogPath, siteUrl).toString() },
]);
const heroLead = isPt
  ? 'Decisões de engenharia em projetos reais, começando pelo fluxo de abastecimento offline do Moto Track.'
  : 'Engineering decisions from real projects, starting with Moto Track\'s offline fuel workflow.';

function formatDate(date: Date): string {
  return date.toLocaleDateString(isPt ? 'pt-BR' : 'en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout
  title={blogSeo.title}
  description={blogSeo.description}
  keywords={blogSeo.keywords}
  ogImage={getSiteOgImageUrl('blog', currentLang)}
  schema={[blogSchema, breadcrumbSchema]}
>
  <Header />

  <main id="main-content" class="relative overflow-x-clip" tabindex="-1">
    <PageHero eyebrow="Blog" title={t['blog.title']} lead={heroLead} crumb="Blog">
      <a
        href={isPt ? '/pt/rss.xml' : '/rss.xml'}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-ghost fade-rise mt-8 min-h-10 px-3 text-sm"
        style="--d: 420ms"
        title="RSS Feed"
        aria-label="RSS Feed"
      >
        <Icon name="rss" size={15} class="text-[#f97316]" />
        <span>RSS</span>
      </a>
    </PageHero>

    <section class="studio-section pt-12 sm:pt-16" aria-label={t['blog.title']}>
      <div class="studio-container">
        <div class="max-w-4xl">
        {sortedPosts.length > 0 ? (
          <div class="space-y-4">
            {sortedPosts.map((post) => {
              const slug = post.data.slug ?? post.id.replace(/^pt\//, '');
              const readingTime = calculateReadingTime(post.body, currentLang);
              const isFallback = post.data.lang !== currentLang;
              const postHref = isPt ? `/pt/blog/${slug}/` : `/blog/${slug}/`;

              return (
                <Spotlight tag="article" class="panel group">
                  <a href={postHref} class="block p-6 sm:p-7">
                    <div class="mb-4 flex flex-wrap items-center gap-2">
                      {post.data.tags.map((tag) => <span class="chip">{tag}</span>)}
                      {isFallback && (
                        <span class="chip border-[rgb(var(--color-accent)/0.45)] text-[rgb(var(--color-accent-hover))]">
                          {isPt ? 'Inglês (Original)' : post.data.lang.toUpperCase()}
                        </span>
                      )}
                    </div>

                    <h2 class="mb-2 text-2xl font-semibold tracking-tight transition-colors group-hover:text-[rgb(var(--color-accent-hover))]">
                      {post.data.title}
                    </h2>

                    <p class="mb-5 line-clamp-2 text-[rgb(var(--color-text-secondary))]">{post.data.description}</p>

                    <div class="flex flex-wrap items-center justify-between gap-3">
                      <div class="flex items-center gap-3 font-mono text-xs text-[rgb(var(--color-text-muted))]">
                        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                        <span aria-hidden="true">·</span>
                        <span class="inline-flex items-center gap-1"><Icon name="clock" size={13} />{readingTime.text}</span>
                      </div>
                      <span class="link-arrow min-h-0 text-sm">
                        {t['blog.readMore']}
                        <Icon name="arrow-up-right" size={15} />
                      </span>
                    </div>
                  </a>
                </Spotlight>
              );
            })}
          </div>
        ) : (
          <EmptyState
            iconName="book-open"
            title={t['blog.emptyTitle']}
            description={t['blog.emptyDesc']}
            actionText={t['blog.backToHome']}
            actionHref={isPt ? "/pt/" : "/"}
          />
        )}
        </div>
      </div>
    </section>

    <CtaBand />
  </main>

  <Footer />
</BaseLayout>
