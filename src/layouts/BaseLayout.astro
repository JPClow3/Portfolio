---
import '@/styles/global.css';
import BackToTop from '@/components/islands/BackToTop.svelte';
import HeroScene from '@/components/islands/HeroScene.svelte';
import { defaultLang, type Lang, ui } from '@/lib/i18n';
import {
  SITE,
  getAlternateOgLocales,
  getOgLocale,
  getPathAlternates,
  buildDefaultSchemas,
} from '@/lib/seo';

interface Props {
  title: string;
  description?: string;
  keywords?: string[];
  ogImage?: string;
  ogType?: 'website' | 'article';
  twitterCard?: 'summary' | 'summary_large_image';
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleTags?: string[];
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
}

const {
  title,
  description = 'Freelance software developer portfolio of João Paulo Santos — web apps, APIs, and automation with Python, Django, and React.',
  keywords = [],
  ogImage = '/og-image.png',
  ogType = 'website',
  twitterCard = 'summary_large_image',
  articlePublishedTime,
  articleModifiedTime,
  articleTags = [],
  schema = [],
  noindex = false,
} = Astro.props;

const currentLang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = ui[currentLang] ?? ui[defaultLang];
const siteUrl = Astro.site ?? new URL(SITE.url);
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const ogImageUrl = new URL(ogImage, siteUrl);
const observabilityEndpoint = import.meta.env.PUBLIC_OBSERVABILITY_ENDPOINT ?? '';
const shouldRenderScene =
  Astro.url.pathname === '/' ||
  Astro.url.pathname === '/pt/' ||
  Astro.url.pathname.startsWith('/projects/');

const alternateLinks = getPathAlternates(Astro.url.pathname, siteUrl);
const ogLocale = getOgLocale(currentLang);
const alternateOgLocales = getAlternateOgLocales(currentLang);
const robotsContent = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const keywordsContent = keywords.length > 0 ? keywords.join(', ') : undefined;

const defaultSchema = buildDefaultSchemas({
  lang: currentLang,
  siteUrl,
  description,
});

const customSchema = Array.isArray(schema) ? schema : [schema];
const allSchema = [...defaultSchema, ...customSchema.filter(Boolean)];
---

<!doctype html>
<html lang={currentLang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywordsContent && <meta name="keywords" content={keywordsContent} />}
    <meta name="author" content={SITE.author} />
    <meta name="creator" content={SITE.author} />
    <meta name="publisher" content={SITE.author} />
    <link rel="canonical" href={canonicalUrl} />
    {alternateLinks.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.url} />
    ))}
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <meta name="theme-color" content="#087896" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#7dd3fc" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale} />
    {alternateOgLocales.map((locale) => (
      <meta property="og:locale:alternate" content={locale} />
    ))}
    {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
    {articleTags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-180x180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="João Paulo" />

    <link rel="alternate" type="application/rss+xml" title="João Paulo Santos — Blog RSS Feed" href={new URL('/rss.xml', siteUrl).toString()} />
    <link rel="alternate" type="application/rss+xml" title="João Paulo Santos — Blog RSS Feed (Português)" href={new URL('/pt/rss.xml', siteUrl).toString()} />

    <link rel="dns-prefetch" href="https://2.gravatar.com" />
    <link rel="preconnect" href="https://2.gravatar.com" crossorigin />

    {allSchema.map((schemaBlock) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaBlock)}></script>
    ))}

    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {
          theme = null;
        }

        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const shouldUseDark = theme === 'dark' || (!theme && prefersDark);

        document.documentElement.classList.toggle('dark', shouldUseDark);
      })();
    </script>

    <script is:inline>
      (() => {
        if (window.location.pathname === '/') {
          const hasPref = localStorage.getItem('languagePreference');
          const wantsPt = (navigator.language || '').toLowerCase().startsWith('pt');
          
          if (hasPref === 'pt' || (!hasPref && wantsPt)) {
            window.location.replace('/pt/' + window.location.search + window.location.hash);
          }
        }
      })();
    </script>

    <script is:inline>
      if ('serviceWorker' in navigator && window.location.protocol.startsWith('http')) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(() => {
            // Service worker registration failure is non-fatal
          });
        });
      }
    </script>

    <script define:vars={{ observabilityEndpoint }} is:inline>
      (() => {
        const isProduction = window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1';
        if (!isProduction) return;

        // Respect Do Not Track
        if (navigator.doNotTrack === '1' || window.doNotTrack === '1') return;

        const endpoint = observabilityEndpoint;
        if (!endpoint) return;

        const sendPayload = (type, payload) => {
          const body = JSON.stringify({
            type,
            timestamp: new Date().toISOString(),
            path: window.location.pathname,
            ...payload,
          });

          if (navigator.sendBeacon) {
            const blob = new Blob([body], { type: 'application/json' });
            navigator.sendBeacon(endpoint, blob);
            return;
          }

          fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body,
            keepalive: true,
          }).catch(() => {
            // Non-blocking telemetry: ignore transport failures.
          });
        };

        let clsValue = 0;
        let lcpValue = null;
        let inpValue = null;
        let fcpValue = null;
        let ttfbValue = null;
        let isVitalsReported = false;

        try {
          // Navigation Timing (TTFB)
          const navEntries = performance.getEntriesByType('navigation');
          if (navEntries.length > 0) {
            const nav = navEntries[0];
            if (nav.responseStart) {
              ttfbValue = Math.round(nav.responseStart);
            }
          }

          // Cumulative Layout Shift (CLS)
          const clsObserver = new PerformanceObserver((entryList) => {
            for (const entry of entryList.getEntries()) {
              if (!entry.hadRecentInput) {
                clsValue += entry.value;
              }
            }
          });
          clsObserver.observe({ type: 'layout-shift', buffered: true });

          // Largest Contentful Paint (LCP)
          const lcpObserver = new PerformanceObserver((entryList) => {
            const entries = entryList.getEntries();
            const lastEntry = entries[entries.length - 1];
            if (lastEntry) {
              lcpValue = Math.round(lastEntry.startTime);
            }
          });
          lcpObserver.observe({ type: 'largest-contentful-paint', buffered: true });

          // First Contentful Paint (FCP)
          const paintObserver = new PerformanceObserver((entryList) => {
            for (const entry of entryList.getEntries()) {
              if (entry.name === 'first-contentful-paint') {
                fcpValue = Math.round(entry.startTime);
              }
            }
          });
          paintObserver.observe({ type: 'paint', buffered: true });

          // Interaction to Next Paint (INP)
          const inpObserver = new PerformanceObserver((entryList) => {
            for (const entry of entryList.getEntries()) {
              if (entry.duration) {
                const duration = Math.round(entry.duration);
                if (inpValue === null || duration > inpValue) {
                  inpValue = duration;
                }
              }
            }
          });
          inpObserver.observe({ type: 'event', durationThreshold: 40, buffered: true });

          const reportVitals = () => {
            if (isVitalsReported) return;
            isVitalsReported = true;

            if (lcpValue !== null) {
              sendPayload('web-vital', { name: 'LCP', value: lcpValue });
            }

            if (fcpValue !== null) {
              sendPayload('web-vital', { name: 'FCP', value: fcpValue });
            }

            if (ttfbValue !== null) {
              sendPayload('web-vital', { name: 'TTFB', value: ttfbValue });
            }

            if (inpValue !== null) {
              sendPayload('web-vital', { name: 'INP', value: inpValue });
            }

            sendPayload('web-vital', {
              name: 'CLS',
              value: Number(clsValue.toFixed(4)),
            });

            clsObserver.disconnect();
            lcpObserver.disconnect();
            paintObserver.disconnect();
            inpObserver.disconnect();
          };

          document.addEventListener(
            'visibilitychange',
            () => {
              if (document.visibilityState === 'hidden') {
                reportVitals();
              }
            },
            { once: true },
          );

          window.addEventListener('pagehide', reportVitals, { once: true });
        } catch {
          // Ignore unsupported browser APIs.
        }

        window.addEventListener('error', (event) => {
          sendPayload('runtime-error', {
            message: event.message,
            source: event.filename,
            line: event.lineno,
            column: event.colno,
          });
        });

        window.addEventListener('unhandledrejection', (event) => {
          const reason = event.reason;
          sendPayload('runtime-error', {
            message:
              typeof reason === 'string'
                ? reason
                : reason?.message || 'Unhandled promise rejection',
          });
        });
      })();
    </script>
  </head>
  <body class="min-h-screen bg-[rgb(var(--color-bg-primary))] text-[rgb(var(--color-text-primary))] antialiased transition-colors duration-200">
    {shouldRenderScene && <HeroScene client:idle />}

    <a
      href="#main-content"
      class="skip-link focus-visible:top-4 focus-visible:left-4"
    >
      {t['common.skipToContent']}
    </a>

    <div class="relative z-10">
      <slot />
    </div>
    
    <!-- Back to top button -->
    <BackToTop client:idle />
  </body>
</html>
