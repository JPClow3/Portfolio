---
import Icon from '@/components/common/Icon.astro';
import ScrollReveal from '@/components/common/ScrollReveal.astro';
import Spotlight from '@/components/common/Spotlight.astro';
import SectionHeading from '@/components/studio/SectionHeading.astro';
import { defaultLang, type Lang } from '@/lib/i18n';
import { getStudioCopy, localePath } from '@/lib/studio';

const currentLang = (Astro.currentLocale ?? defaultLang) as Lang;
const copy = getStudioCopy(currentLang);
const section = copy.sections.services;

---

<section id="services" aria-labelledby="services-heading" class="studio-section">
  <div class="line-grid pointer-events-none absolute inset-x-0 top-0 -z-10 h-[520px] opacity-60" aria-hidden="true"></div>
  <div class="studio-container">
    <SectionHeading id="services-heading" index="02" eyebrow={section.eyebrow} title={section.title} lead={section.lead} />

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-6">
      {copy.services.map((service, index) => (
        <ScrollReveal animation="fade-up" delay={(index % 3) * 90} class="h-full lg:col-span-2">
          <Spotlight tag="article" class="panel flex h-full flex-col p-6 sm:p-7">
            <div class="flex h-full flex-col gap-6">
              <div class="flex flex-1 flex-col">
                <div class="flex items-center justify-between gap-4">
                  <span class="icon-tile"><Icon name={service.icon} size={20} /></span>
                  <span class="mono-label">0{index + 1}</span>
                </div>
                <h3 class="mt-6 text-xl font-semibold tracking-tight sm:text-2xl">{service.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-[rgb(var(--color-text-secondary))] sm:text-base">{service.summary}</p>
                <ul class="mt-5 flex flex-wrap gap-1.5">
                  {service.deliverables.slice(0, 3).map((item) => <li class="chip">{item}</li>)}
                </ul>
                <a href={`${localePath('/services/', currentLang)}#${service.id}`} class="link-arrow mt-auto pt-5 text-sm">
                  {copy.labels.learnMore}<span class="sr-only">: {service.title}</span>
                  <Icon name="arrow-up-right" size={16} />
                </a>
              </div>
            </div>
          </Spotlight>
        </ScrollReveal>
      ))}
    </div>
  </div>
</section>
