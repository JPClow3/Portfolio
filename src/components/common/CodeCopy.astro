---
import { defaultLang, type Lang, ui } from '@/lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang } = Astro.props;
const currentLang = (lang ?? Astro.currentLocale ?? defaultLang) as Lang;
const t = ui[currentLang] ?? ui[defaultLang];
---

<script define:vars={{ copyText: t['blog.copyCode'], copiedText: t['blog.copied'] }} is:inline>
  function setupCopyButtons() {
    const codeBlocks = document.querySelectorAll('pre');

    codeBlocks.forEach((pre) => {
      // Guard against adding multiple buttons
      if (pre.querySelector('.copy-code-button') || pre.dataset.copyInitialized === 'true') {
        return;
      }
      pre.dataset.copyInitialized = 'true';
      pre.style.position = 'relative';

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'copy-code-button';
      button.setAttribute('aria-label', copyText);
      button.title = copyText;

      const copyIcon = `
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="13" height="13" x="9" y="9" rx="2" ry="2"/>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
        </svg>
      `;

      const checkIcon = `
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      `;

      button.innerHTML = `${copyIcon}<span>${copyText}</span>`;

      button.addEventListener('click', async () => {
        const codeElement = pre.querySelector('code');
        const textToCopy = codeElement ? codeElement.innerText : pre.innerText;

        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(textToCopy);
          } else {
            const textarea = document.createElement('textarea');
            textarea.value = textToCopy;
            textarea.style.position = 'fixed';
            textarea.style.opacity = '0';
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);
          }

          button.innerHTML = `${checkIcon}<span>${copiedText}</span>`;
          button.classList.add('copied');
          button.setAttribute('aria-label', copiedText);

          setTimeout(() => {
            button.innerHTML = `${copyIcon}<span>${copyText}</span>`;
            button.classList.remove('copied');
            button.setAttribute('aria-label', copyText);
          }, 2000);
        } catch (err) {
          console.error('Failed to copy code: ', err);
        }
      });

      pre.appendChild(button);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCopyButtons);
  } else {
    setupCopyButtons();
  }

  document.addEventListener('astro:page-load', setupCopyButtons);
</script>

<style is:global>
  .copy-code-button {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.28rem 0.6rem;
    font-size: 0.72rem;
    font-family: inherit;
    font-weight: 600;
    line-height: 1;
    border-radius: 0.375rem;
    background: rgb(var(--color-bg-secondary) / 0.88);
    color: rgb(var(--color-text-secondary));
    border: 1px solid rgb(var(--color-border) / 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0.85;
    cursor: pointer;
    transition: all 0.2s ease;
    z-index: 10;
  }

  .copy-code-button:hover,
  .copy-code-button:focus-visible {
    opacity: 1;
    color: rgb(var(--color-text-primary));
    border-color: rgb(var(--color-accent) / 0.6);
    background: rgb(var(--color-bg-secondary));
    transform: translateY(-1px);
  }

  .copy-code-button.copied {
    background: rgb(34 197 94 / 0.16);
    color: rgb(34 197 94);
    border-color: rgb(34 197 94 / 0.5);
    opacity: 1;
  }

  pre {
    position: relative;
  }
</style>
