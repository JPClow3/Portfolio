{
  "name": "portfolio-observability-worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker for portfolio telemetry, web vitals, error logging, and alerts",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "d1:create": "wrangler d1 create observability-db",
    "d1:migrate": "wrangler d1 execute observability-db --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.111.0"
  }
}
