---
import { getCollection } from 'astro:content';
import EmptyState from '@/components/common/EmptyState.astro';
import { defaultLang, type Lang, ui } from '@/lib/i18n';
import ScrollReveal from '@/components/common/ScrollReveal.astro';

const currentLang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = ui[currentLang] ?? ui[defaultLang];
const localePrefix = currentLang === 'pt' ? '/pt' : '';

const statusLabels: Record<string, string> = {
  'in-development': t['project.inDevelopment'],
  research: t['project.research'],
  prototype: t['project.prototype'],
  'private-source': t['project.privateSource'],
  archived: t['project.archived'],
};

async function getLocalizedCollection(collection: 'projects') {
  const localizedEntries = await getCollection(collection, ({ data }) => data.lang === currentLang);
  if (localizedEntries.length > 0 || currentLang === defaultLang) {
    return localizedEntries;
  }
  return getCollection(collection, ({ data }) => data.lang === defaultLang);
}

const projects = (await getLocalizedCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

const getProjectUrl = (project: any) =>
  project.data.caseStudy ? `${currentLang === 'pt' ? '/pt' : ''}/projects/${project.data.slug}/` : project.data.link ?? project.data.github ?? `${currentLang === 'pt' ? '/pt' : ''}/projects/`;
---

<section id="projects" data-scene-section="projects" aria-labelledby="projects-heading" class="mb-16">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h2 id="projects-heading" class="text-3xl font-bold tracking-tight">{t['home.buildTitle']}</h2>
    <a href={`${localePrefix}/projects/`} class="text-sm text-[rgb(var(--color-text-muted))] transition-colors hover:text-[rgb(var(--color-text-primary))]">{t['home.seeAllProjects']}</a>
  </div>

  <div class="bento-grid">
    {projects.length > 0 ? projects.map((project, index) => {
      const projectUrl = getProjectUrl(project);
      const isExternalProjectUrl = projectUrl.startsWith('http');
      const primaryLabel = project.data.caseStudy ? t['home.caseStudy'] : t['home.viewProject'];
      const proofPoint = project.data.metrics[0];
      const statusLabel = project.data.status !== 'live' ? statusLabels[project.data.status] : undefined;

      return (
        <ScrollReveal animation="fade-up" delay={index * 100} tag="div" class="h-full">
          <article
            data-tilt-card
            data-testid="project-card"
            class="project-card group glass-panel relative flex h-full flex-col overflow-hidden rounded-lg transition-all hover:border-[rgb(var(--color-accent))]/40"
          >
          <div class="absolute inset-0 bg-linear-to-br from-[rgb(var(--color-accent)/0.12)] via-transparent to-[rgb(var(--color-accent-hover)/0.12)] opacity-60 transition-opacity duration-500 group-hover:opacity-100"></div>
          {project.data.image && (
            <div class="project-shot-frame relative z-10">
              <div class="project-shot-chrome" aria-hidden="true">
                <span class="project-shot-dot"></span>
                <span class="project-shot-dot"></span>
                <span class="project-shot-dot"></span>
              </div>
              <div class="aspect-video overflow-hidden">
                <img
                  src={project.data.image}
                  alt={`${project.data.title} website preview`}
                  class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  width="1440"
                  height="900"
                />
              </div>
            </div>
          )}
          <div class="relative z-10 flex min-w-0 flex-1 flex-col p-5">
            <div class="mb-3 flex flex-col items-start gap-2">
              <h3 class="min-w-0 text-xl font-bold leading-tight text-balance">{project.data.title}</h3>
              <div class="flex flex-wrap justify-start gap-1.5">
                {project.data.caseStudy && (
                  <span class="shrink-0 rounded-md border border-[rgb(var(--color-accent)/0.32)] bg-[rgb(var(--color-accent)/0.1)] px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.16em] text-[rgb(var(--color-accent))]">
                    {t['projects.story']}
                  </span>
                )}
                {statusLabel && (
                  <span class="shrink-0 rounded-md border border-[rgb(var(--color-accent)/0.32)] px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.16em] text-[rgb(var(--color-accent))]">
                    {statusLabel}
                  </span>
                )}
              </div>
            </div>
            <p data-testid="project-outcome" class="text-pretty text-sm leading-relaxed text-[rgb(var(--color-text-secondary))]">{project.data.description}</p>

            <div data-testid="project-details" class="mt-4 grid content-start gap-3 sm:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
              {proofPoint && (
                <div data-testid="project-proof" class="min-w-0 rounded-md border border-[rgb(var(--color-accent)/0.22)] bg-[rgb(var(--color-accent)/0.07)] px-3 py-2.5">
                  <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-[rgb(var(--color-text-muted))]">{t['home.proofPoint']}</p>
                  <p class="mt-1 flex flex-wrap items-baseline gap-x-1.5 gap-y-0.5 text-sm text-[rgb(var(--color-text-secondary))]">
                    <strong class="min-w-0 text-lg font-bold leading-tight text-[rgb(var(--color-accent))] text-balance">{proofPoint.value}</strong>
                    <span>{proofPoint.label}</span>
                  </p>
                </div>
              )}

              {project.data.highlights.length > 0 && (
                <div data-testid="project-capabilities">
                  <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-[rgb(var(--color-text-muted))]">{t['home.capabilities']}</p>
                  <ul class="mt-1.5 grid gap-1.5 text-xs leading-relaxed text-[rgb(var(--color-text-secondary))]">
                    {project.data.highlights.slice(0, 2).map((highlight: string) => (
                      <li class="flex gap-2">
                        <span aria-hidden="true" class="mt-[0.45rem] h-1.5 w-1.5 shrink-0 rounded-full bg-[rgb(var(--color-accent))]"></span>
                        <span>{highlight}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>

            <div class="mt-4 flex flex-wrap gap-1.5">
              {project.data.tech.slice(0, 4).map((tech: string) => (
                <span class="rounded-md border border-[rgb(var(--color-border)/0.6)] bg-[rgb(var(--color-bg-secondary)/0.5)] px-2.5 py-1 text-[10px] uppercase tracking-wide text-[rgb(var(--color-text-secondary))] backdrop-blur-md">{tech}</span>
              ))}
            </div>
            <div class="mt-auto flex flex-wrap gap-x-4 gap-y-1 pt-4 text-sm">
              <a
                href={projectUrl}
                target={isExternalProjectUrl ? '_blank' : undefined}
                rel={isExternalProjectUrl ? 'noreferrer' : undefined}
                class="inline-flex min-h-11 items-center font-semibold text-[rgb(var(--color-accent))] hover:underline"
                aria-label={`${primaryLabel} - ${project.data.title}`}
              >
                {primaryLabel}
              </a>
              {project.data.caseStudy && project.data.github && project.data.status !== 'in-development' && (
                <a href={project.data.github} target="_blank" rel="noreferrer" class="inline-flex min-h-11 items-center text-[rgb(var(--color-text-secondary))] transition-colors hover:text-[rgb(var(--color-text-primary))]" aria-label={`View code for ${project.data.title} on GitHub`}>{t['home.code']}</a>
              )}
              {project.data.link && <a href={project.data.link} target="_blank" rel="noreferrer" class="inline-flex min-h-11 items-center text-[rgb(var(--color-text-secondary))] transition-colors hover:text-[rgb(var(--color-text-primary))]" aria-label={`View live site for ${project.data.title}`}>{t['home.live']}</a>}
            </div>
          </div>
        </article>
        </ScrollReveal>
      );
    }) : (
      <div class="col-span-full">
        <EmptyState 
          iconName="code" 
          title={t['projects.emptyTitle']} 
          description={t['projects.emptyDesc']} 
        />
      </div>
    )}
  </div>
</section>
