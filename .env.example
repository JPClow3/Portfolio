# Public Environment Variables for Portfolio (Client-Side & Build Time)

# Public Cloudflare Turnstile site key (embedded in the contact form)
PUBLIC_TURNSTILE_SITEKEY="your-turnstile-sitekey"

# Portfolio Observability & Web Vitals Telemetry Worker Endpoint
PUBLIC_OBSERVABILITY_ENDPOINT="https://jp-portfolio-observability.your-subdomain.workers.dev"

# Sentry browser monitoring (public ingest DSN; do not use an auth token here).
PUBLIC_SENTRY_DSN=""
PUBLIC_SENTRY_ENVIRONMENT="production"
