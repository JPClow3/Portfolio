---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import StudioHero from '@/components/studio/StudioHero.astro';
import ServicesGrid from '@/components/studio/ServicesGrid.astro';
import WorkShowcase from '@/components/studio/WorkShowcase.astro';
import FounderProcess from '@/components/studio/FounderProcess.astro';
import EngineeringSection from '@/components/studio/EngineeringSection.astro';
import FaqSection from '@/components/studio/FaqSection.astro';
import CtaBand from '@/components/studio/CtaBand.astro';
import { defaultLang, type Lang } from '@/lib/i18n';
import { buildHomeFaqSchema, getHomeSeo, getSiteOgImageUrl } from '@/lib/seo';
import { projectHref } from '@/lib/studio';

const currentLang = (Astro.currentLocale ?? defaultLang) as Lang;
const siteUrl = Astro.site ?? new URL('https://jpclow.dev');
const homeSeo = getHomeSeo(currentLang);

const localized = await getCollection('projects', ({ data }) => data.lang === currentLang);
const source = localized.length > 0 ? localized : await getCollection('projects', ({ data }) => data.lang === defaultLang);
const featured = source
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

const workSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: currentLang === 'pt' ? 'Cases em destaque' : 'Selected work',
  itemListElement: featured.map((project, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'CreativeWork',
      name: project.data.title,
      description: project.data.description,
      url: new URL(projectHref(project.data.slug, currentLang), siteUrl).toString(),
      keywords: project.data.tech,
      inLanguage: currentLang === 'pt' ? 'pt-BR' : 'en-US',
      creator: { '@id': `${siteUrl}#organization` },
    },
  })),
};
---

<BaseLayout
  title={homeSeo.title}
  description={homeSeo.description}
  keywords={homeSeo.keywords}
  ogImage={getSiteOgImageUrl('home', currentLang)}
  schema={[buildHomeFaqSchema(currentLang), workSchema]}
>
  <Header />
  <main id="main-content" tabindex="-1" class="relative overflow-x-clip">
    <StudioHero />
    <WorkShowcase />
    <ServicesGrid />
    <EngineeringSection index="03" />
    <FounderProcess index="04" />
    <FaqSection index="05" />
    <CtaBand />
  </main>
  <Footer />
</BaseLayout>
