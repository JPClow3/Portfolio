---
import Icon from '@/components/common/Icon.astro';
import { defaultLang, type Lang, ui } from '@/lib/i18n';
import { getStudioCopy } from '@/lib/studio';

const currentLang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = ui[currentLang] ?? ui[defaultLang];
const copy = getStudioCopy(currentLang);
const currentYear = new Date().getFullYear();
const localePrefix = currentLang === 'pt' ? '/pt' : '';

const serviceLinks = copy.services.map((service) => ({
  name: service.title,
  href: `${localePrefix}/services/#${service.id}`,
}));

const companyLinks = [
  { name: t['nav.company'], href: `${localePrefix}/about/` },
  { name: t['nav.work'], href: `${localePrefix}/projects/` },
  { name: t['nav.process'], href: `${localePrefix}/#process` },
  { name: t['nav.blog'], href: `${localePrefix}/blog/` },
  { name: t['nav.contact'], href: `${localePrefix}/contact/` },
];

const socialLinks = [
  { name: 'Email', href: 'mailto:joao@jpclow.dev', icon: 'email' as const },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/joaopaulosantosgo/', icon: 'linkedin' as const },
  { name: 'GitHub', href: 'https://github.com/JPClow3', icon: 'github' as const },
  { name: 'Instagram', href: 'https://www.instagram.com/_joao.paulo_sa/', icon: 'instagram' as const },
];
---

<footer class="force-dark surface relative overflow-hidden border-t border-[rgb(var(--color-border))]">
  <div class="line-grid pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>

  <div class="studio-container relative py-16">
    <div class="grid gap-12 lg:grid-cols-[1.3fr_1fr_1fr_1fr]">
      <div class="max-w-sm">
        <a href={`${localePrefix}/`} class="inline-flex items-center" aria-label="JPCLOW home">
          <img src="/brand/jpclow-logo-negative.svg" alt="JPCLOW" width="47" height="32" loading="lazy" decoding="async" class="h-9 w-auto" />
        </a>
        <p class="mt-5 text-sm leading-relaxed text-[rgb(var(--color-text-secondary))]">{t['footer.aboutText']}</p>
        <p class="mt-5 flex items-center gap-2 font-mono text-xs text-[rgb(var(--color-text-muted))]">
          <Icon name="location" size={14} />
          {t['footer.location']}
        </p>
      </div>

      <nav aria-label={t['footer.services']}>
        <h2 class="mono-label mb-4">{t['footer.services']}</h2>
        <ul class="space-y-1">
          {serviceLinks.map((link) => (
            <li><a href={link.href} class="u-link inline-block py-2 text-sm text-[rgb(var(--color-text-secondary))] transition-colors hover:text-[rgb(var(--color-text-primary))]">{link.name}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t['footer.company']}>
        <h2 class="mono-label mb-4">{t['footer.company']}</h2>
        <ul class="space-y-1">
          {companyLinks.map((link) => (
            <li><a href={link.href} class="u-link inline-block py-2 text-sm text-[rgb(var(--color-text-secondary))] transition-colors hover:text-[rgb(var(--color-text-primary))]">{link.name}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t['footer.connect']}>
        <h2 class="mono-label mb-4">{t['footer.connect']}</h2>
        <ul class="space-y-1">
          {socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.href.startsWith('http') ? '_blank' : undefined}
                rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="inline-flex min-h-9 items-center gap-2.5 text-sm text-[rgb(var(--color-text-secondary))] transition-colors hover:text-[rgb(var(--color-text-primary))]"
              >
                <Icon name={link.icon} size={16} />
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-14 flex flex-col items-start justify-between gap-4 border-t border-[rgb(var(--color-border))] pt-6 text-xs text-[rgb(var(--color-text-muted))] sm:flex-row sm:items-center">
      <p>&copy; {currentYear} JPCLOW. {t['footer.rights']}</p>
      <a href="#" class="group inline-flex min-h-11 items-center gap-2 transition-colors hover:text-[rgb(var(--color-text-primary))]" aria-label={t['common.backToTop']}>
        {t['common.backToTop']}
        <Icon name="arrow-down" size={14} class="rotate-180 transition-transform group-hover:-translate-y-0.5" />
      </a>
    </div>
  </div>
</footer>
